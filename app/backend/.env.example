# Copy to .env and fill in real values. .env itself is gitignored — never
# commit it. Used both for local `uvicorn` runs and for `docker compose up`
# at the repo root (docker-compose.yml overrides DATABASE_URL/APP_AI_BASE_URL
# for the containerized network; the rest of this file is used as-is).

DATABASE_URL=postgresql+asyncpg://resqkit:resqkit_local_pw@127.0.0.1:5432/resqkit_test
JWT_SECRET_KEY=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ENVIRONMENT=test
FRONTEND_URL=http://127.0.0.1:5174
HOST=0.0.0.0
PORT=8001
ADMIN_EMAIL=admin@resqkit.internal
ADMIN_PASSWORD=change-this-admin-password

# Self-hosted, open-source AI (Ollama, OpenAI-compatible endpoint on localhost).
# No data leaves this machine. Repointing these at a remote provider is an
# explicit operator choice, not a default.
APP_AI_BASE_URL=http://127.0.0.1:11434/v1
APP_AI_KEY=ollama
